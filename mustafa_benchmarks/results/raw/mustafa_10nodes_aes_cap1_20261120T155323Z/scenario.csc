    <mote>
      <interface_config>
        org.contikios.cooja.interfaces.Position
        <x>105.0</x>
        <y>60.0</y>
        <z>0.0</z>
      </interface_config>
      <interface_config>org.contikios.cooja.mspmote.interfaces.MspMoteID<id>10</id>
      </interface_config>
      <motetype_identifier>mtype405</motetype_identifier>
