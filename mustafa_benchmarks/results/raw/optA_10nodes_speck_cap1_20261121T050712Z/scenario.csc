<?xml version='1.0' encoding='UTF-8'?>
<simconf>
  <simulation>
    <title>Mustafa Comparison: 10 nodes on Z1</title>
    <randomseed>123456</randomseed>
    <motedelay_us>1000000</motedelay_us>
    <radiomedium>
